{
  "description": "Client-side React (Vite/CRA-style SPA) with TypeScript and Tailwind.",
  "vars": { "client": false, "server": false, "serverOnly": false },
  "generators": {
    "component": {
      "supports": { "react": ["18", "19"], "styling": ["tailwind-3", "tailwind-4", "styled-components", "emotion", "plain"], "primitives": ["radix", "base", "none"] },
      "description": "Presentational component in its own kebab-case folder.",
      "out": "components",
      "options": {
        "element": { "type": "string", "required": true, "choices": ["div", "span", "section", "article", "aside", "nav", "header", "footer", "main", "ul", "ol", "li", "button", "a", "form", "label", "p", "h1", "h2", "h3", "h4", "h5", "h6"], "description": "Semantic root element. Pick the most meaningful one (button for actions, a for navigation, nav/section/article for regions); div only when nothing else fits." },
        "variants": { "type": "boolean", "requires": [{ "package": "class-variance-authority", "when": { "styling": ["tailwind-3", "tailwind-4", "plain"] } }], "description": "Add cva variant/size props (shadcn style) and export <name>Variants." },
        "as-child": { "type": "boolean", "supports": { "styling": ["tailwind-3", "tailwind-4", "plain"] }, "requires": [{ "package": "@radix-ui/react-slot|radix-ui", "when": { "primitives": ["radix", "none"] } }, { "package": "@base-ui/react", "when": { "primitives": "base" } }], "description": "Add asChild (Radix Slot) so callers can render it as their own element, e.g. a link." },
        "cn": { "type": "string", "description": "Import path of the repo's cn() helper. Auto-detected from components.json or lib/utils; pass only to override." },
        "with-test": { "type": "boolean", "description": "Add a Testing Library test." },
        "with-barrel": { "type": "boolean", "description": "Add an index.ts that re-exports the component. Only when the repo's component folders have one." },
        "with-story": { "type": "boolean", "description": "Add a Storybook CSF3 story (requires .storybook/)." }
      },
      "files": [
        { "template": "component/component.tsx.tpl", "path": "{{name.kebab}}/{{name.kebab}}.tsx", "when": { "styling": ["tailwind-3", "tailwind-4", "plain"] } },
        { "template": "component/component.styled.tsx.tpl", "path": "{{name.kebab}}/{{name.kebab}}.tsx", "when": { "styling": ["styled-components", "emotion"] } },
        { "template": "component/index.ts.tpl", "path": "{{name.kebab}}/index.ts", "when": "withBarrel" },
        { "template": "component/component.test.tsx.tpl", "path": "{{name.kebab}}/{{name.kebab}}.test.tsx", "when": "withTest" },
        { "template": "component/component.stories.tsx.tpl", "path": "{{name.kebab}}/{{name.kebab}}.stories.tsx", "when": "withStory" }
      ],
      "actions": [{ "type": "append", "path": "index.ts", "template": "barrel/export.ts.tpl", "skipIfMissing": true }]
    },
    "hook": {
      "description": "Custom hook (use-thing.ts). Pass the name with or without the use prefix.",
      "out": "hooks",
      "strip": ["use"],
      "options": {
        "with-test": { "type": "boolean", "description": "Add a renderHook test." }
      },
      "files": [
        { "template": "hook/hook.ts.tpl", "path": "use-{{name.kebab}}.ts" },
        { "template": "hook/hook.test.ts.tpl", "path": "use-{{name.kebab}}.test.ts", "when": "withTest" }
      ]
    },
    "context": {
      "description": "Context + Provider + guarded useThing() hook in one file.",
      "out": "contexts",
      "strip": ["context", "provider"],
      "options": {},
      "files": [{ "template": "context/context.tsx.tpl", "path": "{{name.kebab}}-context.tsx" }]
    },
    "util": {
      "description": "Pure utility function in its own kebab-case file.",
      "out": "utils",
      "options": {
        "with-test": { "type": "boolean", "description": "Add a unit test." }
      },
      "files": [
        { "template": "util/util.ts.tpl", "path": "{{name.kebab}}.ts" },
        { "template": "util/util.test.ts.tpl", "path": "{{name.kebab}}.test.ts", "when": "withTest" }
      ]
    },
    "page": {
      "description": "Route-level page component for a client-side router (register it in the router yourself).",
      "out": "pages",
      "strip": ["page"],
      "options": {
        "with-test": { "type": "boolean", "description": "Add a Testing Library test." }
      },
      "files": [
        { "template": "page/page.tsx.tpl", "path": "{{name.kebab}}-page.tsx" },
        { "template": "page/page.test.tsx.tpl", "path": "{{name.kebab}}-page.test.tsx", "when": "withTest" }
      ]
    },
    "form-field": {
      "supports": { "react": ["18", "19"], "primitives": ["radix", "none"], "styling": ["tailwind-3", "tailwind-4", "plain"] },
      "description": "react-hook-form field on the shadcn form primitives: label, control, description and error wired for a11y. Validation lives in the form's zod schema.",
      "out": "components",
      "requires": ["react-hook-form"],
      "requiresUi": ["form", "{{control}}"],
      "options": {
        "control": { "type": "string", "required": true, "choices": ["input", "textarea", "select", "checkbox"], "description": "Which shadcn control the field renders." },
        "with-test": { "type": "boolean", "description": "Add a Testing Library test inside a Form harness." },
        "with-barrel": { "type": "boolean", "description": "Add an index.ts that re-exports the component. Only when the repo's component folders have one." }
      },
      "files": [
        { "template": "form-field/form-field.tsx.tpl", "path": "{{name.kebab}}/{{name.kebab}}.tsx" },
        { "template": "form-field/index.ts.tpl", "path": "{{name.kebab}}/index.ts", "when": "withBarrel" },
        { "template": "form-field/form-field.test.tsx.tpl", "path": "{{name.kebab}}/{{name.kebab}}.test.tsx", "when": "withTest" }
      ],
      "actions": [{ "type": "append", "path": "index.ts", "template": "barrel/export.ts.tpl", "skipIfMissing": true }]
    }
  }
}
