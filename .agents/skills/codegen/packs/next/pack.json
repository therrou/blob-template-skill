{
  "description": "Next.js App Router, Server Components first, TypeScript and Tailwind.",
  "vars": { "client": false, "server": true, "serverOnly": false },
  "generators": {
    "component": {
      "supports": { "react": ["18", "19"], "styling": ["tailwind-3", "tailwind-4", "styled-components", "emotion", "plain"], "primitives": ["radix", "base", "none"] },
      "description": "Server Component (default choice) in its own kebab-case folder.",
      "out": "components",
      "options": {
        "element": { "type": "string", "required": true, "choices": ["div", "span", "section", "article", "aside", "nav", "header", "footer", "main", "ul", "ol", "li", "button", "a", "form", "label", "p", "h1", "h2", "h3", "h4", "h5", "h6"], "description": "Semantic root element. Pick the most meaningful one (button for actions, a for navigation, nav/section/article for regions); div only when nothing else fits." },
        "variants": { "type": "boolean", "requires": [{ "package": "class-variance-authority", "when": { "styling": ["tailwind-3", "tailwind-4", "plain"] } }], "description": "Add cva variant/size props (shadcn style) and export <name>Variants." },
        "as-child": { "type": "boolean", "supports": { "styling": ["tailwind-3", "tailwind-4", "plain"] }, "requires": [{ "package": "@radix-ui/react-slot|radix-ui", "when": { "primitives": ["radix", "none"] } }, { "package": "@base-ui/react", "when": { "primitives": "base" } }], "description": "Add asChild (Radix Slot) so callers can render it as their own element, e.g. a link." },
        "cn": { "type": "string", "description": "Import path of the repo's cn() helper. Auto-detected from components.json or lib/utils; pass only to override." },
        "with-test": { "type": "boolean", "description": "Add a Testing Library test (sync components only)." },
        "with-barrel": { "type": "boolean", "description": "Add an index.ts that re-exports the component. Only when the repo's component folders have one." },
        "with-story": { "type": "boolean", "description": "Add a Storybook CSF3 story (requires .storybook/)." }
      },
      "files": [
        { "template": "@react/component/component.tsx.tpl", "path": "{{file.dir}}{{file.base}}.tsx", "when": { "styling": ["tailwind-3", "tailwind-4", "plain"] } },
        { "template": "@react/component/component.styled.tsx.tpl", "path": "{{file.dir}}{{file.base}}.tsx", "when": { "styling": ["styled-components", "emotion"] } },
        { "template": "@react/component/index.ts.tpl", "path": "{{file.dir}}index.ts", "when": "withBarrel" },
        { "template": "@react/component/component.test.tsx.tpl", "path": "{{file.dir}}{{file.base}}.test.tsx", "when": "withTest" },
        { "template": "@react/component/component.stories.tsx.tpl", "path": "{{file.dir}}{{file.base}}.stories.tsx", "when": "withStory" }
      ],
      "actions": [{ "type": "append", "path": "index.ts", "template": "@react/barrel/export.ts.tpl", "skipIfMissing": true }]
    },
    "client-component": {
      "supports": { "react": ["18", "19"], "styling": ["tailwind-3", "tailwind-4", "styled-components", "emotion", "plain"], "primitives": ["radix", "base", "none"] },
      "description": "Client Component ('use client') for state, effects, event handlers or browser APIs. Keep it a small leaf.",
      "out": "components",
      "vars": { "client": true, "server": false },
      "options": {
        "element": { "type": "string", "required": true, "choices": ["div", "span", "section", "article", "aside", "nav", "header", "footer", "main", "ul", "ol", "li", "button", "a", "form", "label", "p", "h1", "h2", "h3", "h4", "h5", "h6"], "description": "Semantic root element. Pick the most meaningful one (button for actions, a for navigation, nav/section/article for regions); div only when nothing else fits." },
        "variants": { "type": "boolean", "requires": [{ "package": "class-variance-authority", "when": { "styling": ["tailwind-3", "tailwind-4", "plain"] } }], "description": "Add cva variant/size props (shadcn style) and export <name>Variants." },
        "as-child": { "type": "boolean", "supports": { "styling": ["tailwind-3", "tailwind-4", "plain"] }, "requires": [{ "package": "@radix-ui/react-slot|radix-ui", "when": { "primitives": ["radix", "none"] } }, { "package": "@base-ui/react", "when": { "primitives": "base" } }], "description": "Add asChild (Radix Slot) so callers can render it as their own element, e.g. a link." },
        "cn": { "type": "string", "description": "Import path of the repo's cn() helper. Auto-detected from components.json or lib/utils; pass only to override." },
        "with-test": { "type": "boolean", "description": "Add a Testing Library test." },
        "with-barrel": { "type": "boolean", "description": "Add an index.ts that re-exports the component. Only when the repo's component folders have one." },
        "with-story": { "type": "boolean", "description": "Add a Storybook CSF3 story (requires .storybook/)." }
      },
      "files": [
        { "template": "@react/component/component.tsx.tpl", "path": "{{file.dir}}{{file.base}}.tsx", "when": { "styling": ["tailwind-3", "tailwind-4", "plain"] } },
        { "template": "@react/component/component.styled.tsx.tpl", "path": "{{file.dir}}{{file.base}}.tsx", "when": { "styling": ["styled-components", "emotion"] } },
        { "template": "@react/component/index.ts.tpl", "path": "{{file.dir}}index.ts", "when": "withBarrel" },
        { "template": "@react/component/component.test.tsx.tpl", "path": "{{file.dir}}{{file.base}}.test.tsx", "when": "withTest" },
        { "template": "@react/component/component.stories.tsx.tpl", "path": "{{file.dir}}{{file.base}}.stories.tsx", "when": "withStory" }
      ],
      "actions": [{ "type": "append", "path": "index.ts", "template": "@react/barrel/export.ts.tpl", "skipIfMissing": true }]
    },
    "hook": {
      "description": "Custom hook for Client Components (use-thing.ts).",
      "out": "hooks",
      "strip": ["use"],
      "vars": { "client": true },
      "options": {
        "with-test": { "type": "boolean", "description": "Add a renderHook test." }
      },
      "files": [
        { "template": "@react/hook/hook.ts.tpl", "path": "use-{{name.kebab}}.ts" },
        { "template": "@react/hook/hook.test.ts.tpl", "path": "use-{{name.kebab}}.test.ts", "when": "withTest" }
      ]
    },
    "context": {
      "description": "Client context + Provider + guarded useThing() hook. Mount the provider as deep in the tree as possible.",
      "out": "contexts",
      "strip": ["context", "provider"],
      "vars": { "client": true },
      "options": {},
      "files": [{ "template": "@react/context/context.tsx.tpl", "path": "{{name.kebab}}-context.tsx" }]
    },
    "util": {
      "description": "Pure utility function in lib/. Use --server-only for code that must never reach the client bundle.",
      "out": "lib",
      "options": {
        "server-only": { "type": "boolean", "description": "Add import 'server-only' (secrets, DB, server SDKs)." },
        "with-test": { "type": "boolean", "description": "Add a unit test." }
      },
      "files": [
        { "template": "@react/util/util.ts.tpl", "path": "{{name.kebab}}.ts" },
        { "template": "@react/util/util.test.ts.tpl", "path": "{{name.kebab}}.test.ts", "when": "withTest" }
      ]
    },
    "route": {
      "supports": { "next": ["13", "14", "15", "16"] },
      "description": "App Router segment: page.tsx plus optional layout/loading/error. --name is the route path, e.g. blog/[slug] or (marketing)/about.",
      "out": [{ "when": { "app": "next-pages" }, "out": "pages" }, { "out": "app" }],
      "nameKind": "route",
      "options": {
        "with-layout": { "type": "boolean", "supports": { "app": ["!next-pages"] }, "description": "Add layout.tsx." },
        "with-loading": { "type": "boolean", "supports": { "app": ["!next-pages"] }, "description": "Add loading.tsx (Suspense fallback for the segment)." },
        "with-error": { "type": "boolean", "supports": { "app": ["!next-pages"] }, "description": "Add error.tsx (client error boundary)." }
      },
      "files": [
        { "template": "route/page.tsx.tpl", "path": "{{routeDir}}page.tsx", "when": { "app": "!next-pages" } },
        { "template": "pages-route/page.tsx.tpl", "path": "{{routeFile}}.tsx", "when": { "app": "next-pages" } },
        { "template": "route/layout.tsx.tpl", "path": "{{routeDir}}layout.tsx", "when": "withLayout" },
        { "template": "route/loading.tsx.tpl", "path": "{{routeDir}}loading.tsx", "when": "withLoading" },
        { "template": "route/error.tsx.tpl", "path": "{{routeDir}}error.tsx", "when": "withError" }
      ]
    },
    "api-route": {
      "supports": { "next": ["13", "14", "15", "16"] },
      "description": "Route Handler (route.ts) under app/api. --name is the path below /api, e.g. users/[id].",
      "out": [{ "when": { "app": "next-pages" }, "out": "pages/api" }, { "out": "app/api" }],
      "nameKind": "route",
      "options": {
        "with-test": { "type": "boolean", "description": "Add a handler test that calls GET with a Request.", "supports": { "app": ["!next-pages"] } }
      },
      "files": [
        { "template": "api-route/route.ts.tpl", "path": "{{routeDir}}route.ts", "when": { "app": "!next-pages" } },
        { "template": "pages-api/route.ts.tpl", "path": "{{routeFile}}.ts", "when": { "app": "next-pages" } },
        { "template": "api-route/route.test.ts.tpl", "path": "{{routeDir}}route.test.ts", "when": "withTest" }
      ]
    },
    "server-action": {
      "supports": { "app": ["!next-pages"], "next": ["13", "14", "15", "16"] },
      "description": "Server Action module ('use server') for mutations called from forms or client components.",
      "out": "actions",
      "strip": ["action"],
      "options": {},
      "files": [{ "template": "server-action/action.ts.tpl", "path": "{{name.kebab}}.ts" }]
    },
    "form-field": {
      "supports": { "react": ["18", "19"], "primitives": ["radix", "none"], "forms": ["shadcn", "none"], "styling": ["tailwind-3", "tailwind-4", "plain"] },
      "description": "react-hook-form field on the shadcn form primitives: label, control, description and error wired for a11y. Validation lives in the form's zod schema. Always a Client Component.",
      "out": "components",
      "vars": { "client": true },
      "requires": ["react-hook-form"],
      "requiresUi": ["form", "{{control}}"],
      "options": {
        "control": { "type": "string", "required": true, "choices": ["input", "textarea", "select", "checkbox"], "description": "Which shadcn control the field renders." },
        "with-test": { "type": "boolean", "description": "Add a Testing Library test inside a Form harness." },
        "with-barrel": { "type": "boolean", "description": "Add an index.ts that re-exports the component. Only when the repo's component folders have one." }
      },
      "files": [
        { "template": "@react/form-field/form-field.tsx.tpl", "path": "{{file.dir}}{{file.base}}.tsx" },
        { "template": "@react/form-field/index.ts.tpl", "path": "{{file.dir}}index.ts", "when": "withBarrel" },
        { "template": "@react/form-field/form-field.test.tsx.tpl", "path": "{{file.dir}}{{file.base}}.test.tsx", "when": "withTest" }
      ],
      "actions": [{ "type": "append", "path": "index.ts", "template": "@react/barrel/export.ts.tpl", "skipIfMissing": true }]
    }
  }
}
